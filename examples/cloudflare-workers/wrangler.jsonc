{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgeroute-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "DEFAULT_MODEL": "gpt-4o-mini"
  }
}
